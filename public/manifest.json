{
    "manifest_version": 3,
    "name": "Peel",
    "version": "0.1.0",
    "permissions": ["sidePanel", "tabs", "tabGroups", "storage", "alarms"],
    "action": { "default_title": "Open Peel" },
    "side_panel": {"default_path": "index.html"},
    "background": { "service_worker": "service-worker.js", "type": "module" }
}