{
  "manifest_version": 3,
  "name": "Peel",
  "description": "Turn messy tabs into saved, switchable workspaces.",
  "version": "0.1.0",
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Open Peel"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
