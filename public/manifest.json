{
  "manifest_version": 3,
  "name": "Peel",
  "description": "Turn messy tabs into saved, switchable workspaces.",
  "version": "0.1.0",
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Peel",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
